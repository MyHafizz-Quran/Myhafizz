ar": "أَعُوذُ", "tr": "aʿoûdhou", "audio": "https://audio.qurancdn.com/wbw/113_001_002.mp3"}, {"ar": "بِرَبِّ", "tr": "birabbi", "audio": "https://audio.qurancdn.com/wbw/113_001_003.mp3"}, {"ar": "ٱلْفَلَقِ", "tr": "l-falaqi", "audio": "https://audio.qurancdn.com/wbw/113_001_004.mp3"}]}, "113:2": {"key": "113:2", "fr": "contre le mal des êtres qu’Il a créés,", "audio": "https://verses.quran.com/Alafasy/mp3/113002.mp3", "words": [{"ar": "مِن", "tr": "min", "audio": "https://audio.qurancdn.com/wbw/113_002_001.mp3"}, {"ar": "شَرِّ", "tr": "charri", "audio": "https://audio.qurancdn.com/wbw/113_002_002.mp3"}, {"ar": "مَا", "tr": "mâ", "audio": "https://audio.qurancdn.com/wbw/113_002_003.mp3"}, {"ar": "خَلَقَ", "tr": "khalaqa", "audio": "https://audio.qurancdn.com/wbw/113_002_004.mp3"}]}, "113:3": {"key": "113:3", "fr": "contre le mal de l’obscurité quand elle s’approfondit,", "audio": "https://verses.quran.com/Alafasy/mp3/113003.mp3", "words": [{"ar": "وَمِن", "tr": "wamin", "audio": "https://audio.qurancdn.com/wbw/113_003_001.mp3"}, {"ar": "شَرِّ", "tr": "charri", "audio": "https://audio.qurancdn.com/wbw/113_003_002.mp3"}, {"ar": "غَاسِقٍ", "tr": "ghâsiqin", "audio": "https://audio.qurancdn.com/wbw/113_003_003.mp3"}, {"ar": "إِذَا", "tr": "idhâ", "audio": "https://audio.qurancdn.com/wbw/113_003_004.mp3"}, {"ar": "وَقَبَ", "tr": "waqaba", "audio": "https://audio.qurancdn.com/wbw/113_003_005.mp3"}]}, "113:4": {"key": "113:4", "fr": "contre le mal de celles qui soufflent (les sorcières) sur les nœuds,", "audio": "https://verses.quran.com/Alafasy/mp3/113004.mp3", "words": [{"ar": "وَمِن", "tr": "wamin", "audio": "https://audio.qurancdn.com/wbw/113_004_001.mp3"}, {"ar": "شَرِّ", "tr": "charri", "audio": "https://audio.qurancdn.com/wbw/113_004_002.mp3"}, {"ar": "ٱلنَّفَّـٰثَـٰتِ", "tr": "l-nafâthâti", "audio": "https://audio.qurancdn.com/wbw/113_004_003.mp3"}, {"ar": "فِى", "tr": "fî", "audio": "https://audio.qurancdn.com/wbw/113_004_004.mp3"}, {"ar": "ٱلْعُقَدِ", "tr": "l-ʿouqadi", "audio": "https://audio.qurancdn.com/wbw/113_004_005.mp3"}]}, "113:5": {"key": "113:5", "fr": "et contre le mal de l’envieux quand il envie 1.\"", "audio": "https://verses.quran.com/Alafasy/mp3/113005.mp3", "words": [{"ar": "وَمِن", "tr": "wamin", "audio": "https://audio.qurancdn.com/wbw/113_005_001.mp3"}, {"ar": "شَرِّ", "tr": "charri", "audio": "https://audio.qurancdn.com/wbw/113_005_002.mp3"}, {"ar": "حَاسِدٍ", "tr": "ḥâsidin", "audio": "https://audio.qurancdn.com/wbw/113_005_003.mp3"}, {"ar": "إِذَا", "tr": "idhâ", "audio": "https://audio.qurancdn.com/wbw/113_005_004.mp3"}, {"ar": "حَسَدَ", "tr": "ḥasada", "audio": "https://audio.qurancdn.com/wbw/113_005_005.mp3"}]}, "114:1": {"key": "114:1", "fr": "Dis : \"Je cherche protection auprès du Seigneur des hommes.", "audio": "https://verses.quran.com/Alafasy/mp3/114001.mp3", "words": [{"ar": "قُلْ", "tr": "qoul", "audio": "https://audio.qurancdn.com/wbw/114_001_001.mp3"}, {"ar": "أَعُوذُ", "tr": "aʿoûdhou", "audio": "https://audio.qurancdn.com/wbw/114_001_002.mp3"}, {"ar": "بِرَبِّ", "tr": "birabbi", "audio": "https://audio.qurancdn.com/wbw/114_001_003.mp3"}, {"ar": "ٱلنَّاسِ", "tr": "l-nâsi", "audio": "https://audio.qurancdn.com/wbw/114_001_004.mp3"}]}, "114:2": {"key": "114:2", "fr": "Le Souverain des hommes,", "audio": "https://verses.quran.com/Alafasy/mp3/114002.mp3", "words": [{"ar": "مَلِكِ", "tr": "maliki", "audio": "https://audio.qurancdn.com/wbw/114_002_001.mp3"}, {"ar": "ٱلنَّاسِ", "tr": "l-nâsi", "audio": "https://audio.qurancdn.com/wbw/114_002_002.mp3"}]}, "114:3": {"key": "114:3", "fr": "Dieu des hommes,", "audio": "https://verses.quran.com/Alafasy/mp3/114003.mp3", "words": [{"ar": "إِلَـٰهِ", "tr": "ilâhi", "audio": "https://audio.qurancdn.com/wbw/114_003_001.mp3"}, {"ar": "ٱلنَّاسِ", "tr": "l-nâsi", "audio": "https://audio.qurancdn.com/wbw/114_003_002.mp3"}]}, "114:4": {"key": "114:4", "fr": "contre le mal du mauvais conseiller, furtif,", "audio": "https://verses.quran.com/Alafasy/mp3/114004.mp3", "words": [{"ar": "مِن", "tr": "min", "audio": "https://audio.qurancdn.com/wbw/114_004_001.mp3"}, {"ar": "شَرِّ", "tr": "charri", "audio": "https://audio.qurancdn.com/wbw/114_004_002.mp3"}, {"ar": "ٱلْوَسْوَاسِ", "tr": "l-waswâsi", "audio": "https://audio.qurancdn.com/wbw/114_004_003.mp3"}, {"ar": "ٱلْخَنَّاسِ", "tr": "l-khanâsi", "audio": "https://audio.qurancdn.com/wbw/114_004_004.mp3"}]}, "114:5": {"key": "114:5", "fr": "qui insuffle des mauvaises pensées dans les poitrines des hommes,", "audio": "https://verses.quran.com/Alafasy/mp3/114005.mp3", "words": [{"ar": "ٱلَّذِى", "tr": "alladhî", "audio": "https://audio.qurancdn.com/wbw/114_005_001.mp3"}, {"ar": "يُوَسْوِسُ", "tr": "youwaswisou", "audio": "https://audio.qurancdn.com/wbw/114_005_002.mp3"}, {"ar": "فِى", "tr": "fî", "audio": "https://audio.qurancdn.com/wbw/114_005_003.mp3"}, {"ar": "صُدُورِ", "tr": "ṣoudoûri", "audio": "https://audio.qurancdn.com/wbw/114_005_004.mp3"}, {"ar": "ٱلنَّاسِ", "tr": "l-nâsi", "audio": "https://audio.qurancdn.com/wbw/114_005_005.mp3"}]}, "114:6": {"key": "114:6", "fr": "qu’il (le conseiller) soit un djinn, ou un être humain\".", "audio": "https://verses.quran.com/Alafasy/mp3/114006.mp3", "words": [{"ar": "مِنَ", "tr": "mina", "audio": "https://audio.qurancdn.com/wbw/114_006_001.mp3"}, {"ar": "ٱلْجِنَّةِ", "tr": "l-jinati", "audio": "https://audio.qurancdn.com/wbw/114_006_002.mp3"}, {"ar": "وَٱلنَّاسِ", "tr": "wal-nâsi", "audio": "https://audio.qurancdn.com/wbw/114_006_003.mp3"}]}}}